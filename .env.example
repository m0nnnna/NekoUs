# Copy to .env (repo root) and fill in before running:
#   docker compose -f deploy/docker-compose.yml --env-file .env up --build
# See docs/voice-architecture.md for how these pieces fit together, and docs/deployment.md for
# a full guided walkthrough (VPS, DNS, TLS, nginx) if you're starting from nothing.

# --- LiveKit ---
# Generate a random key/secret pair (e.g. `openssl rand -hex 16` for each). Shared by the
# livekit and token-server services — must match exactly, both read from these same two vars.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public IP (or hostname) of the machine running the livekit service — used for ICE candidates
# so clients (including ones behind NAT) can actually reach it. Not needed if you're fronting
# LiveKit with the optional TURN relay (see deploy/livekit.yaml's commented-out turn: block).
HOST_IP=

# Address the four services' reverse-proxied ports bind to on this host. Leave unset (defaults
# to 127.0.0.1) if nginx runs on this SAME host — the normal case. Only set this if nginx instead
# runs on a separate edge/proxy host reaching this one over a private network (e.g. a WireGuard
# tunnel, common with a Cloudflare-fronted edge) — set it to this host's address on that private
# network so the edge host can reach it. See docs/deployment.md's "Split edge-proxy + origin"
# section. Never 0.0.0.0 — these ports have no TLS/auth of their own; nginx provides both.
# BIND_ADDR=10.40.40.2

# Origins allowed to call the token server, comma-separated. Supports one leading wildcard
# subdomain per entry (e.g. https://*.example.com). Use * only for local testing.
# This is NekoUs's own web client's origin (see docs/deployment.md) — deliberately not "chat."
# or "matrix.", so it doesn't collide with wherever your *existing* homeserver already lives.
ALLOWED_ORIGINS=https://app.YOUR_DOMAIN

# --- Bundled homeserver (optional — only used with `docker compose --profile matrix`) ---
# Set by deploy/setup.sh's "let the script provision a homeserver too" path (see docs/deployment.md
# "Option B"). Leave both unset if you're bringing your own homeserver — the `matrix` service in
# deploy/docker-compose.yml doesn't even start without the `matrix` profile, and MATRIX_HOMESERVER_URL
# below just points at your existing one instead.
# MATRIX_SERVER_NAME=YOUR_DOMAIN
# MATRIX_REGISTRATION_TOKEN=

# --- Token server's Matrix service-bot account ---
# This bot must be a member of any room you want voice-gated — it stays joined and reads
# membership/power level locally (services/token-server/src/membership.ts). Register a
# dedicated account for it (not a real user's account) on your homeserver first.
# You don't have to invite it into rooms by hand: the token server publishes this user ID at
# GET /api/livekit/config, and the app invites it into the space and its voice channels itself
# from there (see docs/voice-architecture.md's "Service bot membership").
# The bot only ever joins rooms on its own homeserver that belong to a space it serves — it
# ignores every other invite, including any sent from a federated server. See
# VOICE_ALLOWED_SPACES below and services/token-server/src/tenancy.ts.
# This is your *existing* Matrix homeserver's URL — NOT one of NekoUs's own subdomains above.
MATRIX_HOMESERVER_URL=https://matrix.YOUR_DOMAIN

# Preferred: a long-lived access token (avoids storing a password here at all).
MATRIX_BOT_USER_ID=@nekous-voice-bot:YOUR_DOMAIN
MATRIX_BOT_ACCESS_TOKEN=

# Alternative to the pair above: username/password login on every restart. Leave both empty if
# using MATRIX_BOT_ACCESS_TOKEN instead.
# MATRIX_BOT_USERNAME=
# MATRIX_BOT_PASSWORD=

# Power level at/above which a room member gets LiveKit roomAdmin grants (mute-others, etc.).
# Optional — defaults to 50 (Matrix's own "moderator" convention) if unset.
VOICE_MODERATOR_POWER_LEVEL=50

# Which spaces this deployment mints voice tokens for, comma-separated room IDs
# (!abc123:YOUR_DOMAIN). Optional. Left unset, it serves every space on this homeserver that the
# bot above has been invited into — the right default for a private server, where the homeserver's
# own registration settings already decide who can create a space at all.
# Set it if registration is open, or if this LiveKit deployment is meant for specific spaces:
# the bot then ignores invites from every other space, and the token server refuses their
# channels. Either way it never serves a room created on another homeserver.
# VOICE_ALLOWED_SPACES=

# --- Per-Space voice server config (NOT an env var) ---
# The LiveKit WS URL (wss://livekit.YOUR_DOMAIN) and this token server's public URL
# (https://token.YOUR_DOMAIN or https://app.YOUR_DOMAIN/api/livekit) are NOT set here — they're
# configured per-Space, in-app, under Space Settings, once this stack is running. See
# docs/voice-architecture.md's "State events" section.

# --- Push gateway (background push notifications, services/push-gateway) ---
# Generate with `npx web-push generate-vapid-keys` (from services/push-gateway, or anywhere
# with the `web-push` package available) — a fresh pair, not shared with any other deployment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: address or this deployment's own https:// URL — required by the Web Push spec so a
# push service (e.g. Chrome's) has somewhere to reach out if this deployment misbehaves.
VAPID_SUBJECT=mailto:admin@YOUR_DOMAIN

# --- Push gateway URL (NOT an env var) ---
# This service's own public URL (https://push.YOUR_DOMAIN) is configured in-app instead, under
# Account Settings — it's account-wide, not tied to any one Space the way voice is.
