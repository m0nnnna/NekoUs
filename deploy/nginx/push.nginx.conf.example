# Push gateway — proxy to the Purrlor Web Push bridge, as a separate vhost.
# Copy to e.g. push.yourdomain.com.conf, or fold into a location block on the app's own vhost.
# Push gateway listens on 3002; CORS is handled by the service itself (ALLOWED_ORIGINS in .env).

server {
    listen 443 ssl http2;
    server_name push.YOUR_DOMAIN;

    ssl_certificate /path/to/ssl/fullchain.pem;
    ssl_certificate_key /path/to/ssl/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Optional: HTTP redirect to HTTPS
# server {
#     listen 80;
#     server_name push.YOUR_DOMAIN;
#     return 301 https://$server_name$request_uri;
# }
